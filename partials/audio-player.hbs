<template id="cn-audio-player">
    <section class="cn-audio" aria-label="{{t "Article audio player"}}">
        <button class="cn-audio-launcher" type="button" aria-expanded="false" aria-controls="cn-audio-panel" aria-label="{{t "Play audio"}}" data-label-play="{{t "Play audio"}}" data-label-pause="{{t "Pause audio"}}">
            <span class="cn-audio-play cn-audio-play-launcher">
                <span class="cn-icon-play">{{> "icons/phosphor/play"}}</span>
                <span class="cn-icon-pause">{{> "icons/phosphor/pause"}}</span>
            </span>
            <span class="cn-audio-launcher-title"><span class="cn-audio-listen-label">{{t "Read with La Operadora (AI)"}}</span> <span data-duration></span></span>
            <span class="cn-audio-separator" aria-hidden="true">|</span>
            <span class="cn-audio-description">{{t "Read with La Operadora (AI)"}}</span>
        </button>
        <div class="cn-audio-panel" id="cn-audio-panel">
            <p class="cn-audio-source"></p>
            <button class="cn-audio-close cn-audio-icon-button" type="button" aria-label="{{t "Minimize audio player"}}">{{> "icons/phosphor/minus"}}</button>
            <div class="cn-audio-progress">
                <input class="cn-audio-seek" type="range" min="0" value="0" step="1" aria-label="{{t "Audio progress"}}">
                <div class="cn-audio-times">
                    <span data-current>0:00</span>
                    <span class="cn-audio-end"><span data-duration></span><button class="cn-audio-rate" type="button" aria-label="{{t "Playback speed"}}" data-label="{{t "Playback speed"}}">1×</button></span>
                </div>
            </div>
            <div class="cn-audio-transport">
                <button class="cn-audio-skip cn-audio-icon-button" type="button" data-skip="-15" aria-label="{{t "Rewind 15 seconds"}}">{{> "icons/phosphor/rewind"}}</button>
                <button class="cn-audio-play cn-audio-play-main" type="button" aria-label="{{t "Play audio"}}" data-label-play="{{t "Play audio"}}" data-label-pause="{{t "Pause audio"}}">
                    <span class="cn-icon-play">{{> "icons/phosphor/play"}}</span>
                    <span class="cn-icon-pause">{{> "icons/phosphor/pause"}}</span>
                </button>
                <button class="cn-audio-skip cn-audio-icon-button" type="button" data-skip="15" aria-label="{{t "Forward 15 seconds"}}">{{> "icons/phosphor/fast-forward"}}</button>
            </div>
        </div>
    </section>
</template>
