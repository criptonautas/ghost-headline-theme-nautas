{{!-- The community's Kuno of the day (assets/js/kuno-bar.js): the forum's
    fundraisers tagged with the "Kuno tag" setting, one per UTC day, in the
    lang bar's place. Its title and donate open the fundraiser in a modal:
    the topic's first post, then the campaign's Monero address in place. --}}
<template id="cn-kuno-bar" data-tag="{{@custom.kuno_tag}}">
    <div class="cn-kuno">
        <a class="cn-kuno-link"><span class="cn-kuno-label">kuno</span> <span class="cn-kuno-title"></span></a>
        <span class="cn-kuno-figures" data-of="{{t "of"}}"></span>
        <span class="cn-kuno-track" role="progressbar" aria-valuemin="0" aria-valuemax="100"><span class="cn-kuno-fill"></span></span>
        <button class="cn-kuno-donate" type="button">{{t "donate"}}</button>
        <button class="cn-kuno-close" type="button" aria-label="{{t "Hide until tomorrow"}}">×</button>
        <dialog class="cn-kuno-modal" aria-labelledby="cn-kuno-modal-title">
            <div class="cn-kuno-modal-box">
                <header class="cn-kuno-modal-head">
                    <span class="cn-kuno-label">kuno</span>
                    <h2 class="cn-kuno-modal-title" id="cn-kuno-modal-title"></h2>
                    <button class="cn-kuno-modal-close" type="button" aria-label="{{t "Close"}}">{{> "icons/phosphor/x"}}</button>
                </header>
                <div class="cn-kuno-modal-scroll">
                    <div class="cn-kuno-modal-body"></div>
                    <div class="cn-kuno-modal-tip" hidden>
                        <p>{{t "The donation goes straight to the fundraiser."}}</p>
                        <img class="gh-monero-tip-qr" alt="{{t "Scan from wallet"}}" width="240" height="240">
                        <input class="gh-monero-tip-address" type="text" readonly aria-label="{{t "Monero address"}}">
                        <div class="gh-monero-tip-actions">
                            <button class="gh-reactions-close gh-monero-tip-copy" type="button" data-copied="{{t "copied"}}">{{t "copy address"}}</button>
                            <a class="gh-reactions-close gh-monero-tip-wallet">{{t "open in wallet"}}</a>
                        </div>
                        <button class="gh-monero-tip-dismiss cn-kuno-modal-back" type="button">{{t "back"}}</button>
                    </div>
                </div>
                <footer class="cn-kuno-modal-foot">
                    <div class="cn-kuno-modal-progress"></div>
                    <button class="gh-reactions-close cn-kuno-modal-donate" type="button">{{t "donate"}}</button>
                    <a class="cn-kuno-modal-forum" target="_blank" rel="noopener">{{t "view in the community"}} {{> "icons/phosphor/arrow-square-out"}}</a>
                </footer>
            </div>
        </dialog>
    </div>
</template>
