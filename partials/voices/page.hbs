{{!-- Testimonials on /curso/ and /comunidad/: a few of the list (landing.css), lazy images of the hidden ones never load. --}}
<section class="gh-voices gh-canvas is-{{list}}" aria-labelledby="gh-voices-title">
    <h2 class="gh-voices-title" id="gh-voices-title">{{t "What our community says"}}</h2>
    <div class="gh-voices-list">
        {{#match list "curso"}}{{> "voices/curso"}}{{else}}{{> "voices/comunidad"}}{{/match}}
    </div>
    {{> "voices/shuffle"}}
</section>
