{{!< default}}
{{#post}}
<div class="archive-section">
	<h1 class="global-title">{{title}}</h1>
	{{#if custom_excerpt}}
	<p class="archive-excerpt global-excerpt">{{custom_excerpt}}</p>
	{{/if}}
</div>
<div class="custom-archive loop-section global-padding">
	<div class="global-subtitle">
		<small class="global-subtitle-title">
		{{{t "Explore our {start-bold}tags{end-bold}" start-bold="<span>" end-bold="</span>"}}}
		</small>
	</div>
	{{#get "tags" limit="100" filter="visibility:public" include="count.posts" order="count.posts desc" as |tags|}}
	{{#if tags}}
	{{!-- An index rather than cards, so a channel never passes for a post:
		a row each, its picture (its icon on phones), the name in the post
		cards' heading, its count, description and newest three titles. --}}
	<ol class="loop-wrap is-tags">
		{{#foreach tags}}
		{{#if count.posts}}
		<li class="item is-channel">
			{{!-- From 768px: the channel's social image (criptonautas-featured-cover,
				channel style); without one, a picture drawn here in the covers'
				paper, the name huge and cut by its edges. Either says "tag", so
				the name beside it goes without the hash. --}}
			{{#if og_image}}
			<a class="item-cover has-image" href="{{url}}" tabindex="-1" aria-hidden="true">
				<img src="{{img_url og_image size="m"}}" alt="" width="1200" height="630" loading="lazy" decoding="async">
			</a>
			{{else}}
			<a class="item-cover" href="{{url}}" tabindex="-1" aria-hidden="true">
				<span class="item-cover-name"><span>#</span>{{name}}</span>
				<span class="item-cover-label">{{> "channel-icon" slug=slug}}{{t "Channel"}}</span>
			</a>
			{{/if}}
			<span class="item-icon">{{> "channel-icon" slug=slug}}</span>
			<div class="item-content">
				<h2 class="item-title"><a href="{{url}}">{{name}}</a></h2>
				<small>{{plural count.posts empty=(t "no posts") singular=(t "1 post") plural=(t "% posts")}}</small>
				{{#if description}}
				<p class="item-excerpt">{{description}}</p>
				{{/if}}
				{{#get "posts" filter="tag:{{slug}}" limit="3" fields="title,url" as |latest|}}
				<ul class="item-latest">
					{{#foreach latest}}<li><a href="{{url}}">{{title}}</a></li>{{/foreach}}
				</ul>
				{{/get}}
			</div>
		</li>
		{{/if}}
		{{/foreach}}
	</ol>
	{{/if}}
	{{/get}}
</div>
{{/post}}